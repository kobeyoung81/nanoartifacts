{
  "collections": {
    "spaces": {
      "indexes": [
        {
          "name": "owner_kind",
          "keys": [["owner_user_id", 1], ["kind", 1]]
        },
        {
          "name": "kind_deleted",
          "keys": [["kind", 1], ["deleted_at", 1]]
        }
      ]
    },
    "space_grants": {
      "indexes": [
        {
          "name": "space_user_unique",
          "keys": [["space_id", 1], ["user_id", 1]],
          "unique": true
        },
        {
          "name": "user_space",
          "keys": [["user_id", 1], ["space_id", 1]]
        }
      ]
    },
    "nodes": {
      "indexes": [
        {
          "name": "space_parent_position",
          "keys": [["space_id", 1], ["parent_id", 1], ["position", 1]]
        },
        {
          "name": "space_artifact",
          "keys": [["space_id", 1], ["artifact_id", 1]]
        }
      ]
    }
  }
}
