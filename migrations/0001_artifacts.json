{
  "collections": {
    "artifacts": {
      "indexes": [
        {
          "name": "owner_deleted",
          "keys": [["owner_user_id", 1], ["deleted_at", 1]]
        }
      ]
    },
    "artifacts_versions": {
      "indexes": [
        {
          "name": "artifact_seq_unique",
          "keys": [["artifact_id", 1], ["seq", 1]],
          "unique": true
        },
        {
          "name": "artifact_hash_unique",
          "keys": [["artifact_id", 1], ["content_hash", 1]],
          "unique": true
        }
      ]
    },
    "artifacts_grants": {
      "indexes": [
        {
          "name": "user_artifact_unique",
          "keys": [["user_id", 1], ["artifact_id", 1]],
          "unique": true
        }
      ]
    }
  }
}
